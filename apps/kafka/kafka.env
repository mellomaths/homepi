# Kafka Environment Configuration
# Used by docker compose --env-file kafka.env (see start.sh / stop.sh).
# Do not change CLUSTER_ID after the kafka-data volume has been created.

KAFKA_ADVERTISED_HOST=192.168.1.100
KAFKA_BROKER_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8004

KAFKA_NODE_ID=1
KAFKA_CLUSTER_NAME=homepi
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Heap cap for Raspberry Pi
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M
